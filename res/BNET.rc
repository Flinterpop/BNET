#include <windows.h>
#include <commctrl.h>
#include "resource.h"

// The embedded manifest asks for administrator rights (changing an interface
// address needs them) and for the version 6 common controls the dialog uses.
1 RT_MANIFEST "BNET.manifest"

IDD_MAIN DIALOGEX 0, 0, 360, 284
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "BNET - IP Address Manager"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "&Adapter:", -1, 7, 9, 32, 8
    COMBOBOX        IDC_ADAPTER, 42, 7, 246, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Re&fresh", IDC_REFRESH, 294, 6, 60, 14
    LTEXT           "", IDC_ADAPTER_INFO, 7, 26, 347, 8, SS_ENDELLIPSIS

    GROUPBOX        "IPv4 address", -1, 7, 38, 347, 116
    AUTORADIOBUTTON "&Obtain an IP address automatically (DHCP)", IDC_RAD_DHCP,
                    14, 50, 200, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Use the following IP address:", IDC_RAD_STATIC, 14, 63, 200, 10

    LTEXT           "IP address:", IDC_LBL_IP, 24, 79, 70, 8
    CONTROL         "", IDC_IP, "SysIPAddress32", WS_TABSTOP, 98, 77, 110, 12
    LTEXT           "Subnet mask:", IDC_LBL_MASK, 24, 94, 70, 8
    CONTROL         "", IDC_MASK, "SysIPAddress32", WS_TABSTOP, 98, 92, 110, 12
    LTEXT           "Default gateway:", IDC_LBL_GW, 24, 109, 70, 8
    CONTROL         "", IDC_GW, "SysIPAddress32", WS_TABSTOP, 98, 107, 110, 12
    LTEXT           "Preferred DNS:", IDC_LBL_DNS1, 24, 124, 70, 8
    CONTROL         "", IDC_DNS1, "SysIPAddress32", WS_TABSTOP, 98, 122, 110, 12
    LTEXT           "Alternate DNS:", IDC_LBL_DNS2, 24, 139, 70, 8
    CONTROL         "", IDC_DNS2, "SysIPAddress32", WS_TABSTOP, 98, 137, 110, 12

    LTEXT           "Leave the gateway blank to remove it. DNS servers are optional; leaving both blank clears the static list and lets DHCP supply them.",
                    IDC_HINT, 218, 79, 130, 60

    GROUPBOX        "Additional IP addresses on this adapter", -1, 7, 158, 347, 96
    CONTROL         "", IDC_LIST, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,
                    14, 170, 333, 58
    LTEXT           "IP:", -1, 14, 236, 10, 8
    CONTROL         "", IDC_ADD_IP, "SysIPAddress32", WS_TABSTOP, 26, 234, 90, 12
    LTEXT           "Mask:", -1, 122, 236, 22, 8
    CONTROL         "", IDC_ADD_MASK, "SysIPAddress32", WS_TABSTOP, 146, 234, 90, 12
    PUSHBUTTON      "A&dd", IDC_ADD, 242, 233, 50, 14
    PUSHBUTTON      "&Remove", IDC_REMOVE, 297, 233, 50, 14

    LTEXT           "", IDC_STATUS, 7, 262, 226, 16
    DEFPUSHBUTTON   "&Apply", IDC_APPLY, 239, 261, 55, 16
    PUSHBUTTON      "Close", IDCANCEL, 299, 261, 55, 16
END

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     1, 0, 0, 0
    PRODUCTVERSION  1, 0, 0, 0
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
    FILEFLAGS       0x0L
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Flinterpop"
            VALUE "FileDescription",  "BNET - IP Address Manager"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "BNET"
            VALUE "OriginalFilename", "BNET.exe"
            VALUE "ProductName",      "BNET"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
